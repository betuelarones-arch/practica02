<Window x:Class="practica2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practica2"
        mc:Ignorable="d"
        Title="Gestión de Productos" Height="600" Width="1000"
        Loaded="MainWindow_Loaded">
    
    <Window.Resources>
        <local:FlagToStringConverter x:Key="FlagToStringConverter"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Buscar producto:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <WrapPanel>
                <TextBox x:Name="txtBuscar" Width="300" Margin="0,0,10,0"/>
                <Button Content="Buscar" Width="80" Click="BtnBuscar_Click" Margin="0,0,5,0"/>
                <Button Content="Mostrar todos" Width="120" Click="BtnMostrarTodos_Click" Margin="0,0,5,0"/>
                <Button Content="Nuevo" Width="80" Click="BtnNuevo_Click" Margin="0,0,5,0"/>
                <Button Content="Editar" Width="80" Click="BtnEditar_Click" Margin="0,0,5,0"/>
                <Button Content="Eliminar" Width="80" Click="BtnEliminar_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="dgProductos" Grid.Row="1" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="50"/>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="200"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat=C2}" Width="80"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Flag, Converter={StaticResource FlagToStringConverter}}" Width="80"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding CreationDate, StringFormat=dd/MM/yyyy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtMensaje" Grid.Row="2" Margin="0,10,0,0" FontWeight="SemiBold"/>
    </Grid>
</Window>
