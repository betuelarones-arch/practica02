<Window x:Class="practica2.ProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#007ACC" Padding="20,15">
            <TextBlock x:Name="txtTitulo" Text="Nuevo Producto" 
                       FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>
        
        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,0">
            <StackPanel>
                <!-- Información Básica -->
                <Border Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Información Básica" FontSize="14" FontWeight="Bold" 
                                   Foreground="#007ACC" Margin="0,0,0,10"/>
                        
                        <StackPanel x:Name="spId" Visibility="Collapsed">
                            <TextBlock Text="ID Producto" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtId" Style="{StaticResource InputStyle}" 
                                     IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,12"/>
                        </StackPanel>
                        
                        <TextBlock Text="Código *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtCodigo" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Nombre *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtNombre" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtDescripcion" Style="{StaticResource InputStyle}" 
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="70" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>
                
                <!-- Detalles del Producto -->
                <Border Background="White" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Detalles del Producto" FontSize="14" FontWeight="Bold" 
                                   Foreground="#007ACC" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio *" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtPrecio" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock *" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtStock" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Text="Categoría" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cboCategoria" Padding="8,6" FontSize="13" Margin="0,0,0,5" IsEditable="True">
                            <ComboBoxItem Content="Electrónica"/>
                            <ComboBoxItem Content="Ropa"/>
                            <ComboBoxItem Content="Hogar"/>
                            <ComboBoxItem Content="Deportes"/>
                            <ComboBoxItem Content="Juguetes"/>
                            <ComboBoxItem Content="Libros"/>
                            <ComboBoxItem Content="Alimentos"/>
                            <ComboBoxItem Content="Salud"/>
                            <ComboBoxItem Content="Belleza"/>
                            <ComboBoxItem Content="Otros"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer con botones -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="35"
                        Style="{StaticResource ButtonStyle}"
                        Background="White" Foreground="#666666" BorderBrush="#CCCCCC"
                        Click="BtnCancelar_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnGuardar" Content="Guardar" Width="100" Height="35"
                        Style="{StaticResource ButtonStyle}"
                        Background="#007ACC" Foreground="White" BorderBrush="#007ACC"
                        Click="BtnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
